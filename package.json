{
  "name": "metrictv",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "A dependency-light business wallboard with a fictional demo and private read-only Shopify connections.",
  "scripts": {
    "start": "node server.mjs",
    "start:live": "node server/live-server.mjs",
    "start:beta": "node server/beta/beta-server.mjs",
    "beta:init": "node scripts/beta-admin.mjs init",
    "beta:migrate": "node scripts/beta-admin.mjs migrate",
    "beta:invite": "node scripts/beta-admin.mjs invite",
    "beta:revoke": "node scripts/beta-admin.mjs revoke",
    "beta:owners": "node scripts/beta-admin.mjs owners",
    "check": "node scripts/check.mjs && npm run format:check",
    "format": "prettier --write \"{public,server,tests,scripts}/**/*.{js,mjs,css,html}\" server.mjs package.json .prettierrc.json",
    "format:check": "prettier --check \"{public,server,tests,scripts}/**/*.{js,mjs,css,html}\" server.mjs package.json .prettierrc.json",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@shopify/shopify-api": "15.0.1",
    "better-auth": "1.7.14"
  }
}
