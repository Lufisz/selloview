# MetricTV self-hosted configuration.
#
# Copy this file OUTSIDE the project directory, for example to /etc/metrictv/metrictv.env,
# fill it in and make it readable only by the service user (chmod 600).
# Never commit the filled-in copy. See docs/self-hosting.md for every step.

# --- Required ---------------------------------------------------------------------------------

# Absolute path to the SQLite database, outside the project. `beta:init` creates it.
BETA_DB_PATH=/var/lib/metrictv/metrictv.sqlite

# Random secret, at least 32 characters. Generate with: openssl rand -base64 48
BETA_AUTH_SECRET=

# The exact HTTPS address people will open, with no trailing slash or path.
# http is accepted only for 127.0.0.1/localhost trials.
BETA_ORIGIN=https://metrictv.example.com

# Loopback port the server listens on. The server always binds to 127.0.0.1;
# put a reverse proxy with HTTPS in front of it.
BETA_PORT=4330

# --- Email sign-in codes (needed to sign in) -----------------------------------------------------

# Resend API key and a sender on a domain you have verified in Resend. Set both or neither.
# Without them nobody can receive a sign-in code.
BETA_RESEND_API_KEY=
BETA_MAIL_FROM=MetricTV <metrictv@example.com>

# --- Shopify (set all six, or none) ---------------------------------------------------------------

# Client ID and secret of the custom app you create for your own store in the Shopify Dev Dashboard.
BETA_SHOPIFY_CLIENT_ID=
BETA_SHOPIFY_CLIENT_SECRET=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Keep it with your backups: losing it means reconnecting Shopify.
BETA_SHOPIFY_ENCRYPTION_KEY=
# Private directory for encrypted Shopify credentials, outside the project.
BETA_SHOPIFY_TOKEN_DIR=/var/lib/metrictv/shopify-grants
# The one store this instance may connect, as its *.myshopify.com address.
BETA_SHOPIFY_ALLOWED_STORE=your-store.myshopify.com
# The one owner email allowed to connect that store. Invite the same address with beta:invite.
BETA_SHOPIFY_OWNER_EMAIL=you@example.com

# --- Optional -----------------------------------------------------------------------------------

# Only if your reverse proxy ALWAYS overwrites this header with the real client address.
# Leave empty otherwise; a header a client can set itself would bypass rate limits.
# BETA_TRUSTED_IP_HEADER=x-real-ip

# Off by default. Self-hosted instances normally invite their owner instead.
# BETA_SELF_REGISTRATION=enabled
# BETA_REGISTRATION_MAX_ACCOUNTS=10
