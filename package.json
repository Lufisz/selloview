{
  "name": "metrictv",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "A dependency-light business wallboard with a fictional demo and private read-only Shopify connections.",
  "scripts": {
    "start": "node server/demo.mjs",
    "start:server": "node server/main.mjs",
    "admin": "node scripts/admin.mjs",
    "check": "node scripts/check.mjs && npm run format:check",
    "format": "prettier --write \"{public,server,tests,scripts}/**/*.{js,mjs,css,html}\" package.json .prettierrc.json",
    "format:check": "prettier --check \"{public,server,tests,scripts}/**/*.{js,mjs,css,html}\" package.json .prettierrc.json",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@shopify/shopify-api": "15.0.1",
    "better-auth": "1.7.14"
  }
}
