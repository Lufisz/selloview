# Selloview self-hosted configuration.
#
# Copy this file OUTSIDE the project directory, for example to /etc/selloview/selloview.env,
# fill it in and make it readable only by the service user (chmod 600).
# Never commit the filled-in copy. See docs/self-hosting.md for every step.

# --- Required ---------------------------------------------------------------------------------

# Absolute path to the SQLite database, outside the project. `npm run admin -- init` creates it.
SELLOVIEW_DB_PATH=/var/lib/selloview/selloview.sqlite

# Random secret, at least 32 characters. Generate with: openssl rand -base64 48
SELLOVIEW_AUTH_SECRET=

# The exact HTTPS address people will open, with no trailing slash or path.
# http is accepted only for 127.0.0.1/localhost trials.
SELLOVIEW_ORIGIN=https://selloview.example.com

# Loopback port the server listens on. The server always binds to 127.0.0.1;
# put a reverse proxy with HTTPS in front of it.
SELLOVIEW_PORT=4330

# --- Email sign-in codes (needed to sign in) -----------------------------------------------------

# Resend API key and a sender on a domain you have verified in Resend. Uncomment and fill in both
# or neither. Without them the server starts, but nobody can receive a sign-in code.
# SELLOVIEW_RESEND_API_KEY=
# SELLOVIEW_MAIL_FROM=Selloview <selloview@example.com>

# --- Shopify (uncomment and fill in all six, or none) ---------------------------------------------
# Left as they are, the server starts and reports "setup required" instead of a store connection.

# Client ID and secret of the custom app you create for your own store in the Shopify Dev Dashboard.
# SELLOVIEW_SHOPIFY_CLIENT_ID=
# SELLOVIEW_SHOPIFY_CLIENT_SECRET=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Keep it with your backups: losing it means reconnecting Shopify.
# SELLOVIEW_SHOPIFY_ENCRYPTION_KEY=
# Private directory for encrypted Shopify credentials, outside the project.
# SELLOVIEW_SHOPIFY_TOKEN_DIR=/var/lib/selloview/shopify-grants
# The one store this instance may connect, as its *.myshopify.com address.
# SELLOVIEW_SHOPIFY_ALLOWED_STORE=your-store.myshopify.com
# The one owner email allowed to connect that store. Invite the same address with
# `npm run admin -- invite`.
# SELLOVIEW_SHOPIFY_OWNER_EMAIL=you@example.com

# --- Optional -----------------------------------------------------------------------------------

# Rate limits count visitors by the address in this header: behind a reverse proxy every visitor
# otherwise looks like the proxy and shares one set of limits. It is on because the Caddyfile in
# deploy/ always overwrites X-Real-IP with the real visitor address. With another proxy keep the line
# only if that proxy always overwrites the header it names (a header a visitor can set themselves
# would let them dodge the limits), and remove it when no proxy is in front.
SELLOVIEW_TRUSTED_IP_HEADER=x-real-ip

# Off by default. Self-hosted instances normally invite their owner instead.
# SELLOVIEW_SELF_REGISTRATION=enabled
# SELLOVIEW_REGISTRATION_MAX_ACCOUNTS=10
